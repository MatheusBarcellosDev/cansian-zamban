# URL pública do site (OG/WhatsApp). Enquanto o domínio oficial
# não aponta para a Vercel, use a URL .vercel.app:
# NEXT_PUBLIC_SITE_URL=https://cansian-zamban.vercel.app
NEXT_PUBLIC_SITE_URL=https://cansian-zamban.vercel.app

# Resend — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Destinatário das solicitações de evento
EVENTS_TO_EMAIL=eventos@cansianzamban.com.br

# Remetente verificado no Resend (após validar o domínio)
# EVENTS_FROM_EMAIL="Cansian Zamban <contato@cansianzamban.com.br>"
